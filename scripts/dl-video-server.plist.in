<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by `make serve-api-install`; @VENV@/@HOME@ are substituted. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kevinpostal.dl-video-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>@VENV@/bin/dl-video-server</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- yt-dlp lives in ~/.local/bin; ffmpeg and node (yt-dlp JS challenges) in Homebrew. -->
        <key>PATH</key>
        <string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- 077: the log below and every file the server writes stay owner-only. -->
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/dl-video-server.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/dl-video-server.log</string>
</dict>
</plist>
